# Copiar a .env y ajustar si es necesario

# --- Base de datos (Postgres en contenedor, gratis mientras se desarrolla) ---
POSTGRES_USER=gekko
POSTGRES_PASSWORD=gekko_dev_password
POSTGRES_DB=gekko_saas_development
DATABASE_HOST=db
DATABASE_PORT=5432

# Cuando se migre a un Postgres administrado gratuito (Supabase/Neon),
# basta con definir DATABASE_URL y Rails la usará en vez de las variables de arriba:
# DATABASE_URL=postgres://usuario:password@host:5432/basededatos

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Rails ---
RAILS_ENV=development
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
# Generar con `docker compose run --rm app bin/rails secret`
SECRET_KEY_BASE=change_me_generate_with_rails_secret
