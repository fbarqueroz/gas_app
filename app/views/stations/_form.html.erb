<div class="gk-card">
  <%= form_with model: station, local: true do |f| %>
    <% if station.errors.any? %>
      <div class="mb-4 rounded-xl border border-red-400 bg-red-50 px-4 py-3 text-sm text-red-700">
        <%= pluralize(station.errors.count, "error") %> impidieron guardar la estación:
        <ul class="list-disc pl-5">
          <% station.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :name, "Nombre", class: "gk-label" %>
      <%= f.text_field :name, class: "gk-field" %>
    </div>

    <div class="mb-4 grid grid-cols-2 gap-4">
      <div>
        <%= f.label :province, "Provincia", class: "gk-label" %>
        <%= f.text_field :province, class: "gk-field" %>
      </div>
      <div>
        <%= f.label :canton, "Cantón", class: "gk-label" %>
        <%= f.text_field :canton, class: "gk-field" %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :address, "Dirección", class: "gk-label" %>
      <%= f.text_field :address, class: "gk-field" %>
    </div>

    <div class="mb-6">
      <%= f.label :status, "Estado", class: "gk-label" %>
      <%= f.select :status, [["Activa", "active"], ["Pausada", "paused"], ["Cerrada", "closed"]], {}, class: "gk-field" %>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Guardar", class: "gk-btn-primary" %>
      <%= link_to "Cancelar", stations_path, class: "gk-btn-secondary" %>
    </div>
  <% end %>
</div>
