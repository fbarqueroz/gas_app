<% if notice %>
  <div class="mb-6 rounded-xl border border-gekko-green bg-gekko-green-light px-4 py-3 text-sm font-medium text-gekko-green-dark">
    <%= notice %>
  </div>
<% end %>
<% if alert %>
  <div class="mb-6 rounded-xl border border-red-400 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
    <%= alert %>
  </div>
<% end %>
