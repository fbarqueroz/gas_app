<% content_for :page_title, "Dashboard" %>

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
  <div class="gk-kpi">
    <span class="gk-kpi-label">Ventas de hoy</span>
    <span class="gk-kpi-value">₡<%= number_with_delimiter(@today_total_cents / 100) %></span>
    <span class="gk-chip-green w-fit"><%= pluralize(@today_sales.count, "venta") %></span>
  </div>

  <div class="gk-kpi">
    <span class="gk-kpi-label">Turnos abiertos</span>
    <span class="gk-kpi-value"><%= @open_shifts.count %></span>
    <span class="gk-chip-gray w-fit">en <%= pluralize(@stations.count, "estación") %></span>
  </div>

  <div class="gk-kpi">
    <span class="gk-kpi-label">Diferencia de caja (hoy)</span>
    <span class="gk-kpi-value <%= @cash_differences_cents.negative? ? 'text-red-600' : 'text-gekko-green-dark' %>">
      ₡<%= number_with_delimiter(@cash_differences_cents / 100) %>
    </span>
    <span class="<%= @cash_differences_cents.zero? ? 'gk-chip-green' : 'gk-chip-gray' %> w-fit">
      <%= @cash_differences_cents.zero? ? "Cuadrado" : "Revisar" %>
    </span>
  </div>

  <div class="gk-kpi">
    <span class="gk-kpi-label">Estaciones activas</span>
    <span class="gk-kpi-value"><%= @stations.active.count %></span>
    <span class="gk-chip-black w-fit">de <%= @stations.count %> totales</span>
  </div>
</div>

<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="gk-card lg:col-span-2">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="font-heading text-lg font-semibold text-gekko-black">Turnos abiertos ahora</h2>
      <%= link_to "Ver todos", shifts_path, class: "text-sm font-semibold text-gekko-green hover:underline" %>
    </div>

    <% if @open_shifts.any? %>
      <div class="divide-y divide-gekko-gray-100">
        <% @open_shifts.each do |shift| %>
          <%= link_to shift, class: "flex items-center justify-between py-3 hover:bg-gekko-gray-50 rounded-lg px-2 -mx-2" do %>
            <div>
              <p class="font-medium text-gekko-black"><%= shift.station.name %></p>
              <p class="text-sm text-gekko-gray-600"><%= shift.attendant.full_name %> · desde <%= l(shift.opened_at, format: :short) rescue shift.opened_at.strftime("%H:%M") %></p>
            </div>
            <span class="gk-chip-green">Abierto</span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gekko-gray-600">No hay turnos abiertos en este momento.</p>
    <% end %>

    <div class="mt-4">
      <%= link_to "Abrir nuevo turno", new_shift_path, class: "gk-btn-primary" %>
    </div>
  </div>

  <div class="gk-card">
    <h2 class="mb-4 font-heading text-lg font-semibold text-gekko-black">Estaciones</h2>
    <div class="flex flex-col gap-3">
      <% @stations.each do |station| %>
        <%= link_to station, class: "flex items-center justify-between rounded-xl border border-gekko-gray-100 px-3 py-2 hover:border-gekko-green" do %>
          <span class="text-sm font-medium text-gekko-black"><%= station.name %></span>
          <span class="gk-chip-green"><%= station.status.humanize %></span>
        <% end %>
      <% end %>
    </div>
    <%= link_to "+ Nueva estación", new_station_path, class: "mt-4 gk-btn-secondary w-full" %>
  </div>
</div>
