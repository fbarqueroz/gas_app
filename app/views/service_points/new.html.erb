<% content_for :page_title, "Nuevo surtidor — #{@island.name}" %>
<div class="max-w-md gk-card">
  <%= form_with model: @service_point, url: island_service_points_path(@island), local: true do |f| %>
    <div class="mb-4">
      <%= f.label :label, "Etiqueta", class: "gk-label" %>
      <%= f.text_field :label, class: "gk-field", placeholder: "SP-1" %>
    </div>
    <div class="mb-4">
      <%= f.label :kind, "Tipo", class: "gk-label" %>
      <%= f.select :kind, [["Bomba de combustible", "fuel_pump"], ["Cargador eléctrico", "ev_charger"]], {}, class: "gk-field" %>
    </div>
    <div class="mb-6">
      <%= f.label :status, "Estado", class: "gk-label" %>
      <%= f.select :status, [["Operativo", "operational"], ["Mantenimiento", "maintenance"], ["Fuera de servicio", "out_of_service"]], {}, class: "gk-field" %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Crear", class: "gk-btn-primary" %>
      <%= link_to "Cancelar", station_path(@island.station), class: "gk-btn-secondary" %>
    </div>
  <% end %>
</div>
