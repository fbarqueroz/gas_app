<% content_for :page_title, "Editar isla" %>
<div class="max-w-md gk-card">
  <%= form_with model: @island, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :name, "Nombre de la isla", class: "gk-label" %>
      <%= f.text_field :name, class: "gk-field" %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Guardar", class: "gk-btn-primary" %>
      <%= link_to "Cancelar", station_path(@island.station), class: "gk-btn-secondary" %>
    </div>
  <% end %>
</div>
