<% content_for :page_title, "Nueva isla — #{@station.name}" %>
<div class="max-w-md gk-card">
  <%= form_with model: @island, url: station_islands_path(@station), local: true do |f| %>
    <div class="mb-4">
      <%= f.label :name, "Nombre de la isla", class: "gk-label" %>
      <%= f.text_field :name, class: "gk-field", placeholder: "Isla 1" %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Crear isla", class: "gk-btn-primary" %>
      <%= link_to "Cancelar", station_path(@station), class: "gk-btn-secondary" %>
    </div>
  <% end %>
</div>
