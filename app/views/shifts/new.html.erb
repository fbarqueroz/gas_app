<% content_for :page_title, "Abrir turno" %>
<div class="max-w-md gk-card">
  <%= form_with model: @shift, local: true do |f| %>
    <div class="mb-6">
      <%= f.label :station_id, "Estación", class: "gk-label" %>
      <%= f.select :station_id, @stations.map { |s| [s.name, s.id] }, {}, class: "gk-field" %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Abrir turno", class: "gk-btn-primary" %>
      <%= link_to "Cancelar", shifts_path, class: "gk-btn-secondary" %>
    </div>
  <% end %>
</div>
